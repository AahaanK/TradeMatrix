# TradeMatrix Environment Configuration Example

# Database URL: defaults to SQLite file for zero-config local development, or PostgreSQL for production
DATABASE_URL=sqlite:///tradematrix.db
# DATABASE_URL=postgresql://tradematrix:tradematrix@localhost:5432/tradematrix

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=true

# Market Data Caching & Upload
CACHE_DIR=.cache/tradematrix/data
CACHE_TTL_DAYS=7
MAX_UPLOAD_MB=10

# Baseline Financial Defaults
DEFAULT_ANNUAL_RF=0.0
DEFAULT_COMMISSION_BPS=5.0
DEFAULT_SLIPPAGE_BPS=5.0
